# Copy to project root as `.env` before `docker compose up`
# cp .env.example .env

# ── PostgreSQL (host machine connects on port 5433) ─────────────────────────
POSTGRES_USER=papervault
POSTGRES_PASSWORD=papervault
POSTGRES_DB=papervault
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
DATABASE_URL=postgresql://papervault:papervault@127.0.0.1:5433/papervault

# ── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0

# ── Qdrant (vector search) ───────────────────────────────────────────────────
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=papers

# ── arXiv ingestion scope ────────────────────────────────────────────────────
ARXIV_CATEGORIES=cs.*,physics.*,math.*,q-bio.*,q-fin.*,stat.*,eess.*,econ.*
ARXIV_MAX_RESULTS_PER_CATEGORY=100

# ── LLM (RAG uses local Ollama by default) ───────────────────────────────────
LLM_MODE=local
GOOGLE_AI_API_KEY=
